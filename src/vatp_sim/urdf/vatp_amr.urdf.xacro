<?xml version="1.0"?>
<!-- Mobile manipulator: diff-drive base + 2D lidar + 6-DOF arm + 2-finger gripper. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="vatp_amr">
  <xacro:arg name="controllers_yaml" default=""/>

  <xacro:property name="PI" value="3.14159265359"/>

  <xacro:macro name="box_inertial" params="m x y z">
    <inertial><mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" iyy="${m*(x*x+z*z)/12}" izz="${m*(x*x+y*y)/12}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cyl_inertial" params="m r l">
    <inertial><mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+l*l)/12}" iyy="${m*(3*r*r+l*l)/12}" izz="${m*r*r/2}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ===================================================== base -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.10"/>
  </joint>
  <link name="base_link">
    <visual><geometry><box size="0.60 0.40 0.14"/></geometry><material name="body"><color rgba="0.15 0.35 0.75 1"/></material></visual>
    <collision><geometry><box size="0.60 0.40 0.14"/></geometry></collision>
    <xacro:box_inertial m="12.0" x="0.6" y="0.4" z="0.14"/>
  </link>

  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <visual><origin rpy="${PI/2} 0 0"/><geometry><cylinder radius="0.10" length="0.05"/></geometry><material name="wheel"><color rgba="0.05 0.05 0.05 1"/></material></visual>
      <collision><origin rpy="${PI/2} 0 0"/><geometry><cylinder radius="0.10" length="0.05"/></geometry></collision>
      <xacro:cyl_inertial m="0.8" r="0.10" l="0.05"/>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="left" y="0.245"/>
  <xacro:wheel name="right" y="-0.245"/>

  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual><geometry><sphere radius="0.03"/></geometry></visual>
      <collision><geometry><sphere radius="0.03"/></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface></collision>
      <inertial><mass value="0.2"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/><child link="${name}_caster"/><origin xyz="${x} 0 -0.07"/>
    </joint>
  </xacro:macro>
  <xacro:caster name="front" x="0.25"/>
  <xacro:caster name="rear" x="-0.25"/>

  <!-- ===================================================== lidar -->
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.04" length="0.05"/></geometry><material name="lidar"><color rgba="0.1 0.1 0.1 1"/></material></visual>
    <inertial><mass value="0.2"/><inertia ixx="1e-4" iyy="1e-4" izz="1e-4" ixy="0" ixz="0" iyz="0"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/><origin xyz="0.31 0 -0.02"/>
  </joint>

  <!-- ===================================================== arm -->
  <link name="arm_base_link">
    <visual><geometry><cylinder radius="0.06" length="0.06"/></geometry><material name="arm"><color rgba="0.9 0.5 0.1 1"/></material></visual>
    <collision><geometry><cylinder radius="0.06" length="0.06"/></geometry></collision>
    <xacro:cyl_inertial m="0.8" r="0.06" l="0.06"/>
  </link>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/><child link="arm_base_link"/><origin xyz="0.16 0 0.10"/>
  </joint>

  <xacro:macro name="arm_link" params="name length radius mass">
    <link name="${name}">
      <visual><origin xyz="${length/2} 0 0" rpy="0 ${PI/2} 0"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry>
        <material name="arm"><color rgba="0.9 0.5 0.1 1"/></material></visual>
      <collision><origin xyz="${length/2} 0 0" rpy="0 ${PI/2} 0"/><geometry><cylinder radius="${radius}" length="${length}"/></geometry></collision>
      <inertial><origin xyz="${length/2} 0 0"/><mass value="${mass}"/>
        <inertia ixx="${mass*radius*radius/2}" iyy="${mass*(3*radius*radius+length*length)/12}" izz="${mass*(3*radius*radius+length*length)/12}" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
  </xacro:macro>
  <xacro:macro name="arm_joint" params="name parent child xyz axis lo hi effort:=60 velocity:=1.5">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/><child link="${child}"/><origin xyz="${xyz}"/><axis xyz="${axis}"/>
      <limit lower="${lo}" upper="${hi}" effort="${effort}" velocity="${velocity}"/>
      <dynamics damping="1.0" friction="0.2"/>
    </joint>
  </xacro:macro>

  <xacro:arm_link name="shoulder_link" length="0.08" radius="0.045" mass="1.0"/>
  <xacro:arm_link name="upper_arm_link" length="0.38" radius="0.035" mass="1.5"/>
  <xacro:arm_link name="forearm_link" length="0.36" radius="0.030" mass="1.0"/>
  <xacro:arm_link name="wrist_1_link" length="0.07" radius="0.028" mass="0.4"/>
  <xacro:arm_link name="wrist_2_link" length="0.07" radius="0.028" mass="0.4"/>
  <xacro:arm_link name="wrist_3_link" length="0.05" radius="0.026" mass="0.3"/>

  <xacro:arm_joint name="arm_joint_1" parent="arm_base_link" child="shoulder_link" xyz="0 0 0.03" axis="0 0 1" lo="-3.0" hi="3.0"/>
  <xacro:arm_joint name="arm_joint_2" parent="shoulder_link" child="upper_arm_link" xyz="0.08 0 0" axis="0 1 0" lo="-2.1" hi="1.7" effort="120"/>
  <xacro:arm_joint name="arm_joint_3" parent="upper_arm_link" child="forearm_link" xyz="0.38 0 0" axis="0 1 0" lo="-2.6" hi="2.6" effort="80"/>
  <xacro:arm_joint name="arm_joint_4" parent="forearm_link" child="wrist_1_link" xyz="0.36 0 0" axis="1 0 0" lo="-3.0" hi="3.0" effort="30"/>
  <xacro:arm_joint name="arm_joint_5" parent="wrist_1_link" child="wrist_2_link" xyz="0.07 0 0" axis="0 1 0" lo="-2.2" hi="2.2" effort="30"/>
  <xacro:arm_joint name="arm_joint_6" parent="wrist_2_link" child="wrist_3_link" xyz="0.07 0 0" axis="1 0 0" lo="-3.0" hi="3.0" effort="20"/>

  <!-- gripper: palm + two prismatic fingers closing along y -->
  <link name="gripper_link">
    <visual><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.14 0.04"/></geometry><material name="grip"><color rgba="0.3 0.3 0.3 1"/></material></visual>
    <collision><origin xyz="0.04 0 0"/><geometry><box size="0.08 0.14 0.04"/></geometry></collision>
    <xacro:box_inertial m="0.4" x="0.08" y="0.14" z="0.04"/>
  </link>
  <joint name="gripper_mount_joint" type="fixed">
    <parent link="wrist_3_link"/><child link="gripper_link"/><origin xyz="0.05 0 0"/>
  </joint>
  <link name="grasp_frame"/>
  <joint name="grasp_frame_joint" type="fixed">
    <parent link="gripper_link"/><child link="grasp_frame"/><origin xyz="0.14 0 0"/>
  </joint>

  <xacro:macro name="finger" params="name sign">
    <link name="${name}_finger">
      <visual><origin xyz="0.07 0 0"/><geometry><box size="0.12 0.016 0.04"/></geometry><material name="fing"><color rgba="0.1 0.1 0.1 1"/></material></visual>
      <collision><origin xyz="0.07 0 0"/><geometry><box size="0.12 0.016 0.04"/></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>2.0</mu2></ode></friction></surface></collision>
      <xacro:box_inertial m="0.05" x="0.12" y="0.016" z="0.04"/>
    </link>
    <joint name="${name}_finger_joint" type="prismatic">
      <parent link="gripper_link"/><child link="${name}_finger"/>
      <origin xyz="0.08 ${sign*0.095} 0"/><axis xyz="0 ${-sign} 0"/>
      <limit lower="0" upper="0.06" effort="40" velocity="0.2"/>
      <dynamics damping="0.5" friction="0.1"/>
    </joint>
  </xacro:macro>
  <xacro:finger name="left" sign="1"/>
  <xacro:finger name="right" sign="-1"/>

  <!-- ===================================================== ros2_control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="pos_joint" params="name initial:=0.0">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:pos_joint name="arm_joint_1"/>
    <xacro:pos_joint name="arm_joint_2" initial="-1.6"/>
    <xacro:pos_joint name="arm_joint_3" initial="2.6"/>
    <xacro:pos_joint name="arm_joint_4"/>
    <xacro:pos_joint name="arm_joint_5" initial="-2.2"/>
    <xacro:pos_joint name="arm_joint_6"/>
    <xacro:pos_joint name="left_finger_joint"/>
    <xacro:pos_joint name="right_finger_joint"/>
  </ros2_control>

  <!-- ===================================================== Gazebo -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers_yaml)</parameters>
    </plugin>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.49</wheel_separation>
      <wheel_radius>0.10</wheel_radius>
      <max_linear_acceleration>1.5</max_linear_acceleration>
      <max_angular_acceleration>3.0</max_angular_acceleration>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publisher_frequency>30</odom_publisher_frequency>
    </plugin>
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_nested_model_pose>false</publish_nested_model_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <publish_collision_pose>false</publish_collision_pose>
      <publish_visual_pose>false</publish_visual_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>false</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
  </gazebo>
  <gazebo reference="front_caster"><mu1>0.0</mu1><mu2>0.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="rear_caster"><mu1>0.0</mu1><mu2>0.0</mu2><kp>1e6</kp><kd>1.0</kd></gazebo>
  <gazebo reference="left_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="right_wheel"><mu1>1.2</mu1><mu2>1.2</mu2></gazebo>
  <gazebo reference="base_link">
    <visual><material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material></visual>
  </gazebo>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan><horizontal><samples>200</samples><min_angle>-1.6</min_angle><max_angle>1.6</max_angle></horizontal></scan>
        <range><min>0.12</min><max>8.0</max><resolution>0.02</resolution></range>
      </lidar>
    </sensor>
  </gazebo>
</robot>
